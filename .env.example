# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # "anon" / publishable key — safe for the browser
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # "service_role" / secret key — server only, never expose

# Which shop to show when the domain is not listed in shops.domains (e.g. *.vercel.app previews)
DEFAULT_SHOP_SLUG=demo

# Public URL of this deployment (used for Telegram buttons and webhooks)
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
